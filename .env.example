# Sao chép file này thành ".env" rồi điền key nếu muốn cấu hình bằng file.
# (Bạn cũng có thể nhập key trực tiếp trong app ở phần ⚙️ Cài đặt.)

# OpenAI API key cho trợ lý ChatGPT
OPENAI_API_KEY=

# Model mặc định (gpt-4o-mini | gpt-4o | gpt-4.1 | gpt-4.1-mini)
OPENAI_MODEL=gpt-4o-mini

# Cổng chạy server
PORT=3000
